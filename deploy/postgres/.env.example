# Copy to .env and set a real password. `.env` is gitignored — never commit a real credential.
#   cp .env.example .env && sed -i "s/CHANGE_ME/$(openssl rand -base64 24 | tr -d '/+=')/" .env

POSTGRES_DB=thamizh
POSTGRES_USER=thamizh
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Connection string the app will use (matches the values above):
#   postgresql://thamizh:<password>@127.0.0.1:5432/thamizh
